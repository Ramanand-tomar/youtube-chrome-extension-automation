{
  "manifest_version": 3,
  "name": "YouTube Shorts & Instagram Reels Uploader",
  "version": "2.0.0",
  "description": "Upload YouTube Shorts and Instagram Reels through a backend processing pipeline.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "cookies"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://www.instagram.com/*", "https://instagram.com/*", "https://youtube-chrome-extension-automation.onrender.com/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
